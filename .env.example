# === AI model (chat) — via OpenRouter ===
# Dapatkan API key di https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Slug model OpenRouter, contoh: anthropic/claude-sonnet-4.5, openai/gpt-5
AI_CHAT_MODEL=anthropic/claude-sonnet-4.5
# Model murah untuk auto-generate judul percakapan (boleh sama dengan AI_CHAT_MODEL)
AI_TITLE_MODEL=anthropic/claude-haiku-4.5

# === Embedding (untuk RAG / vector search) ===
# Coba dulu lewat OpenRouter; jika model embedding tidak tersedia di OpenRouter,
# isi EMBEDDING_PROVIDER=openai dan OPENAI_API_KEY sebagai fallback (lihat lib/ai/embeddings.ts).
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-small
OPENAI_API_KEY=

# === Database (Supabase Postgres + pgvector) ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — HANYA dipakai di server (API routes, script ingestion), jangan pernah diekspos ke client.
SUPABASE_SERVICE_ROLE_KEY=

# === Aplikasi ===
# UUID user default untuk MVP single-user (harus sama dengan baris yang di-seed di migrasi 0001).
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001

# Secret untuk melindungi endpoint /api/ingest/run dari akses publik (dipakai oleh cron/n8n).
INGEST_CRON_SECRET=

# === Penyimpanan file asli (Google Drive, via OAuth akun pribadi) ===
# Dipakai oleh fitur upload dokumen (/documents) untuk menyimpan file PDF asli;
# teks/chunk/embedding-nya tetap di Supabase seperti biasa, ini hanya untuk
# backup + link "lihat file asli". Lihat lib/storage/googleDrive.ts.
# Kenapa OAuth, bukan service account: service account tidak punya kuota
# penyimpanan Drive sendiri, dan pada akun Google pribadi (bukan Workspace)
# tidak ada cara untuk memberinya kuota — filenya harus tersimpan atas nama
# akun pengguna sungguhan.
# Setup: buat OAuth Client ID tipe "Desktop app" di Google Cloud Console
# (APIs & Services > Credentials), lalu jalankan sekali:
#   npx tsx scripts/googleDriveAuth.ts
# untuk mendapatkan GOOGLE_OAUTH_REFRESH_TOKEN (butuh GOOGLE_OAUTH_CLIENT_ID
# dan GOOGLE_OAUTH_CLIENT_SECRET sudah diisi lebih dulu).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# ID folder Drive tujuan upload (bagian setelah /folders/ di URL folder itu).
GOOGLE_DRIVE_FOLDER_ID=
